{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The Settings window may read and change the settings, presets and output folders, read which engines the app uses, and open the licence list and the sources page, and nothing else.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-choose-fallback-folder",
    "allow-choose-output-folder",
    "allow-delete-preset",
    "allow-engines",
    "allow-get-settings",
    "allow-open-licences",
    "allow-open-sources",
    "allow-presets",
    "allow-save-preset",
    "allow-set-drop-window-at-launch",
    "allow-set-output-beside",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
