{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the app's own commands and listen for its events, and nothing else: no other core defaults, no plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-add-paths",
    "allow-cancel-row",
    "allow-engine-version",
    "allow-get-settings",
    "allow-open-settings",
    "allow-pick-files",
    "allow-queue-rows",
    "allow-quit-now",
    "allow-remove-input",
    "allow-remove-rows",
    "allow-reorder-input",
    "allow-retry-row",
    "allow-reveal-row",
    "allow-set-mode",
    "allow-set-target",
    "allow-start",
    "allow-targets",
    "allow-toggle-drop-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
