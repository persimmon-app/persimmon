{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Persimmon",
  "identifier": "io.github.persimmon-app.Persimmon",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Persimmon",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "drop",
        "title": "Drop",
        "url": "drop.html",
        "width": 160,
        "height": 120,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 560,
        "height": 420,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "fileAssociations": [
      {
        "name": "Image",
        "description": "Images",
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "png",
          "webp",
          "heic",
          "heif",
          "tiff",
          "tif",
          "gif",
          "avif",
          "bmp"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Video",
        "description": "Video",
        "ext": [
          "mov",
          "mp4",
          "mkv",
          "webm",
          "avi"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Audio",
        "description": "Audio",
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "wav",
          "flac",
          "opus"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "PDF",
        "description": "PDF document",
        "ext": [
          "pdf"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Archive",
        "description": "Archives",
        "ext": [
          "zip",
          "tar",
          "tar.gz",
          "tgz",
          "tar.bz2",
          "tbz2",
          "tar.xz",
          "txz",
          "tar.zst",
          "tzst",
          "7z",
          "rar"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
